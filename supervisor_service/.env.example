# Agent 1 only needs the remote Agent 2 endpoint.
SUPERVISOR_URL=https://supervisorservice.vercel.app/api
SUPERVISOR_CLIENT_TOKEN=replace-with-a-random-shared-token

# Agent 2 provider pool. Providers must expose an OpenAI-compatible
# /chat/completions endpoint. Keep keys in Vercel encrypted environment variables.
# Configure at least two providers for failover.

SUPERVISOR_PROVIDER_1_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
SUPERVISOR_PROVIDER_1_KEY=replace-with-provider-1-key
SUPERVISOR_PROVIDER_1_MODEL=replace-with-provider-1-model

SUPERVISOR_PROVIDER_2_URL=https://api.groq.com/openai/v1/chat/completions
SUPERVISOR_PROVIDER_2_KEY=replace-with-provider-2-key
SUPERVISOR_PROVIDER_2_MODEL=replace-with-provider-2-model

SUPERVISOR_PROVIDER_3_URL=
SUPERVISOR_PROVIDER_3_KEY=
SUPERVISOR_PROVIDER_3_MODEL=

SUPERVISOR_PROVIDER_4_URL=
SUPERVISOR_PROVIDER_4_KEY=
SUPERVISOR_PROVIDER_4_MODEL=

SUPERVISOR_PROVIDER_5_URL=
SUPERVISOR_PROVIDER_5_KEY=
SUPERVISOR_PROVIDER_5_MODEL=
